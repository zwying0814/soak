---
import {Icon} from "astro-icon/components";
import {formatDateToYYYYMMDD, getRecentPosts, getBlurImage} from "@/utils/func";
import {type CollectionEntry} from "astro:content";
import { sidebarConfig } from "~/config/sidebar";
const posts: CollectionEntry<"posts">[] = await getRecentPosts()
---

<section class="card rounded-box mt-4 sticky top-16 bg-base-100">
    <div class="px-4 py-2 my-2 flex items-center">
        <div class="size-5 flex items-center justify-center mr-1.5 rounded-full text-white bg-green-500">
            <Icon name="eye-2-line"/>
        </div>
        <span>最近文章</span>
    </div>
    {sidebarConfig.recent_article_style === 'card' &&
        posts.map(post => {
            return <a href={`/posts/${post.id}`} class="block px-3 pb-3 group">
                <div class="flex overflow-hidden relative flex-col h-28 rounded-lg">
                    <div class="object-cover absolute inset-0 bg-center bg-cover transition duration-300 ease-out group-hover:scale-120 dark:brightness-90"
                         style={`background-image: url(${getBlurImage(post.data.thumbnail?.src)});`}>
                    </div>
                    <div class="absolute left-0 bottom-0 z-10 p-2 text-xs w-full text-white bg-gradient-to-b from-transparent to-black">
                        <div class="">{formatDateToYYYYMMDD(post.data.created)}</div>
                        <div class="line-clamp-1 text-sm"> {post.data.title}</div>
                    </div>
                </div>
            </a>
        })
    }
    {sidebarConfig.recent_article_style === 'simple' &&
            <ul class="timeline timeline-vertical timeline-compact px-4 pb-6">
                {
                    posts.map((post, idx:number) => {
                            return (
                                    <li>
                                        {idx !== 0 &&
                                                <hr/>}
                                        <div class="timeline-middle">
                                            {
                                                idx === 0 ? (
                                                        <div class="inline-grid *:[grid-area:1/1]">
                                                            <div class="status status-error animate-ping"></div>
                                                            <div class="status status-error"></div>
                                                        </div>
                                                ) : (
                                                        <div aria-label="status" class="status status-primary"></div>
                                                )
                                            }
                                        </div>
                                        <div class="timeline-end rounded-box py-2 px-4 w-full hover:bg-base-300 transition">
                                            <a href={`/posts/${post.id}`} class="block group">
                                                <div class="flex flex-col">
                                                    <div class="text-sm line-clamp-1">{post.data.title}</div>
                                                    <div class="text-xs text-gray-500">{formatDateToYYYYMMDD(post.data.created)}</div>
                                                </div>
                                            </a>
                                        </div>
                                        {idx !== posts.length - 1 &&
                                                <hr/>}
                                    </li>
                            )
                        }
                    )
                }
            </ul>
    }
</section>