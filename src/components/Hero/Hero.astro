---
import type { WordCount } from "@/utils/types";
import type { CollectionEntry } from "astro:content";
import HomeHero from "./HomeHero.astro";
import CategoryHero from "./CategoryHero.astro";
import PostHero from "./PostHero.astro";
import NotFoundHero from "./NotFoundHero.astro";
import FriendsHero from "./FriendsHero.astro";

interface Props {
    ctx?: CollectionEntry<"posts" | "pages">["data"];
    pageType: string;
    count?: WordCount;
    categoryWords?: number;
    categoryName?: string;
    categoryTotal?: number;
}

const { ctx, pageType, count, categoryName, categoryTotal, categoryWords } =
    Astro.props;
---

{pageType === "home" && <HomeHero ctx={ctx} />}
{pageType === "category" && <CategoryHero categoryName={categoryName} categoryTotal={categoryTotal} categoryWords={categoryWords} />}
{pageType === "post" && <PostHero ctx={ctx} count={count} />}
{pageType === "404" && <NotFoundHero />}
{pageType === "friends" && <FriendsHero ctx={ctx} />}
