---
import { getRandomImage } from "@/utils/func";
import { homeConfig } from "~/config/home";
---

<div
    data-hero-box
    style={`height:${homeConfig.top_image_height};background-image:url(${getRandomImage()})`}
    class="hero bg-gray-300 mb-4 flex bg-center relative text-2xl leading-8 flex-col justify-center items-center object-cover bg-cover"
>
    <div class="max-w-screen-md z-10 text-center mt-10 px-10 py-6 backdrop-blur-lg rounded-lg text-white border border-base-100/20 shadow-xl">
        <div class="font-serif sm:text-4xl text-2xl">页面不存在</div>
        <div class="mt-3 text-sm sm:mt-6 sm:text-base">
            <span>点击站点标题去首页看看吧！</span>
        </div>
    </div>
</div>