---
import { siteConfig } from '~/config/site';
import { validateCommentConfig } from '@/utils/types';

// 开发环境下进行配置验证
if (import.meta.env.DEV) {
  const validation = validateCommentConfig(siteConfig.comment);
  if (!validation.valid) {
    console.error(`[Twikoo配置错误] ${validation.error}`);
  }
}
---

{siteConfig.comment?.enabled && siteConfig.comment.provider === 'twikoo' && siteConfig.comment.twikoo && (
<div class="mt-12">
  <!-- 评论区分隔线 -->
  <div class="divider divider-start">
    <span class="text-base-content/60 font-medium">评论</span>
  </div>

  <div id="tcomment" class="mt-6">
    <div class="flex items-center justify-center py-8 text-base-content/60">
      <div class="loading loading-spinner loading-md mr-2"></div>
      <span>正在加载评论...</span>
    </div>
  </div>

  <script is:inline define:vars={{
    envId: siteConfig.comment.twikoo.envId,
    region: siteConfig.comment.twikoo.region,
    lang: siteConfig.comment.lang || 'zh-CN'
  }}>
    function init() {
      const container = document.getElementById('tcomment');
      if (!container) return;

      // 显示加载状态
      container.innerHTML = `
        <div class="flex items-center justify-center py-8 text-base-content/60">
          <div class="loading loading-spinner loading-md mr-2"></div>
          <span>正在加载评论...</span>
        </div>
      `;

      const script = document.createElement('script');
      script.src = 'https://registry.npmmirror.com/twikoo/1.6.44/files/dist/twikoo.min.js';

      script.onload = () => {
        setTimeout(() => {
          try {
            const config = { envId, el: '#tcomment', path: location.pathname, lang };
            if (region) config.region = region;

            if (typeof twikoo !== 'undefined') {
              twikoo.init(config).catch(error => {
                console.error('Twikoo 初始化失败:', error);
                container.innerHTML = `
                  <div class="alert alert-warning shadow-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.96-.833-2.732 0L3.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
                    </svg>
                    <div>
                      <h3 class="font-bold">评论加载失败</h3>
                      <div class="text-xs">请检查网络连接或稍后重试</div>
                    </div>
                  </div>
                `;
              });
            } else {
              throw new Error('Twikoo 脚本加载失败');
            }
          } catch (error) {
            console.error('Twikoo 配置错误:', error);
            container.innerHTML = `
              <div class="alert alert-error shadow-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div>
                  <h3 class="font-bold">评论系统配置错误</h3>
                  <div class="text-xs">请联系管理员</div>
                </div>
              </div>
            `;
          }
        }, 100);
      };

      script.onerror = () => {
        console.error('Twikoo 脚本加载失败');
        container.innerHTML = `
          <div class="alert alert-warning shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.96-.833-2.732 0L3.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
            </svg>
            <div>
              <h3 class="font-bold">网络连接问题</h3>
              <div class="text-xs">无法加载评论组件，请检查网络连接</div>
            </div>
          </div>
        `;
      };

      document.body.appendChild(script);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
    document.addEventListener('astro:page-load', init);
  </script>
</div>
)}