---
import {formatDateToYYYYMMDD} from "@/utils/func";
import {Icon} from "astro-icon/components";
import {siteConfig} from "~/config/site";
interface Props {
    slug: string;
    title: string;
    created: Date
}
const {created, title, slug} = Astro.props
---
<div class="text-xs flex flex-col rounded-box py-6 px-4 my-6 bg-base-200/80 relative overflow-hidden">
    <div class="z-10">
        <div class="flex items-center gap-x-4">
            <div class="flex items-center">
                <div class="size-4 shrink-0 flex items-center justify-center mr-1.5 rounded-full text-white bg-teal-500">
                    <div class="transform scale-75">
                        <Icon name="account-circle-fill"/>
                    </div>
                </div>
                <span>作者信息：{siteConfig.author.username}</span>
            </div>
            <div class="flex items-center">
                <div class="size-4 shrink-0 flex items-center justify-center mr-1.5 rounded-full text-white bg-pink-500">
                    <div class="transform scale-75">
                        <Icon name="time"/>
                    </div>
                </div>
                <span>发表于：{formatDateToYYYYMMDD(created)}</span>
            </div>
        </div>
        <div class="flex items-center my-2">
            <div class="size-4 shrink-0 flex items-center justify-center mr-1.5 rounded-full text-white bg-indigo-500">
                <div class="transform scale-75">
                    <Icon name="stack-fill"/>
                </div>
            </div>
            <span>本文标题：</span>
            <a class="text-blue-600 hover:text-blue-400 font-bold" target="_blank"
               href={`/posts/${slug}`}>
                {title}
            </a>
        </div>
        <div class="flex items-center">
            <div class="size-4 shrink-0 flex items-center justify-center mr-1.5 rounded-full text-white bg-yellow-500">
                <div class="transform scale-75">
                    <Icon name="creative-commons-fill"/>
                </div>
            </div>
            <div>本文采用&nbsp;
                <a target="_blank" class="text-blue-600 hover:text-blue-400 font-bold"
                   href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh-Hans">
                    知识共享署名-非商业性使用-相同方式共享 4.0 国际许可协议</a>
                &nbsp;进行许可
            </div>
        </div>
    </div>
    <svg viewBox="0 0 496 512"
         class="transition absolute pointer-events-none -translate-y-1/2 dark:text-white/5 right-6 w-40 text-gray-200 top-1/2">
        <path d="m245.83 214.87l-33.22 17.28c-9.43-19.58-25.24-19.93-27.46-19.93c-22.13 0-33.22 14.61-33.22 43.84c0 23.57 9.21 43.84 33.22 43.84c14.47 0 24.65-7.09 30.57-21.26l30.55 15.5c-6.17 11.51-25.69 38.98-65.1 38.98c-22.6 0-73.96-10.32-73.96-77.05c0-58.69 43-77.06 72.63-77.06c30.72-.01 52.7 11.95 65.99 35.86m143.05 0l-32.78 17.28c-9.5-19.77-25.72-19.93-27.9-19.93c-22.14 0-33.22 14.61-33.22 43.84c0 23.55 9.23 43.84 33.22 43.84c14.45 0 24.65-7.09 30.54-21.26l31 15.5c-2.1 3.75-21.39 38.98-65.09 38.98c-22.69 0-73.96-9.87-73.96-77.05c0-58.67 42.97-77.06 72.63-77.06c30.71-.01 52.58 11.95 65.56 35.86M247.56 8.05C104.74 8.05 0 123.11 0 256.05c0 138.49 113.6 248 247.56 248c129.93 0 248.44-100.87 248.44-248c0-137.87-106.62-248-248.44-248m.87 450.81c-112.54 0-203.7-93.04-203.7-202.81c0-105.42 85.43-203.27 203.72-203.27c112.53 0 202.82 89.46 202.82 203.26c-.01 121.69-99.68 202.82-202.84 202.82"
              fill="currentColor"></path>
    </svg>
</div>