---
import {formatDateToYYYYMMDD, getBlurImage} from "@/utils/func";
import { word_count } from "~/plugin/soak_wasm/pkg-bundler/soak_wasm";

import {Icon} from "astro-icon/components";
const {post} = Astro.props;
const img = getBlurImage(post.data.thumbnail?.src);
---

<a href={`/posts/${post.id}`} 
   class="card bg-base-100 w-full shadow-sm group hover:shadow-lg transition duration-300">
    <!-- 图片区域 -->
    <figure class="h-36 sm:h-44 md:h-48 overflow-hidden">
        <img class="object-cover bg-center bg-cover w-full h-full dark:brightness-90" 
             src={img} alt={post.data.title}/>
    </figure>

    <!-- 文本区域 -->
    <div class="card-body p-2 sm:p-3 md:p-4">

        <!-- 标题 -->
        <h2 class="card-title text-sm sm:text-base md:text-lg font-serif line-clamp-2 leading-snug mb-0.5"
            style="min-height: 2rem;" >
            {post.data.title}
        </h2>

        <!-- 分类 + 标签（可横向滚动） -->
        <div class="flex items-center text-[10px] sm:text-xs md:text-sm mb-0.5 overflow-x-auto whitespace-nowrap no-scrollbar">
        <div class="size-3 flex items-center justify-center me-1 rounded-full bg-red-500 text-white shrink-0">
            <div class="transform scale-75">
            <Icon name="tag"/>
            </div>
        </div>
        <span>{post.data.categories.join(" / ")}</span>

        {post.data.tags?.length > 0 && (
            <>
            <span class="mx-1 text-gray-400 shrink-0">#</span>
            <span>{post.data.tags.join(" #")}</span>
            </>
        )}
        </div>
        
        <!-- 日期 + 字数 -->
        <div class="flex justify-between items-center text-[10px] sm:text-xs md:text-sm">
            <div class="flex items-center">
                <div class="size-3 flex items-center justify-center me-1 rounded-full bg-sky-500 text-white">
                    <div class="transform scale-75">
                        <Icon name="time"/>
                    </div>
                </div>
                <span>{formatDateToYYYYMMDD(post.data.created)}</span>
            </div>
        <div class="flex items-center">
            <div class="size-3 flex items-center justify-center me-1 rounded-full bg-green-500 text-white">
                <div class="transform scale-75">
                    <Icon name="textCount"/>
                </div>
            </div>
            <span>{`${word_count(post.body).words}字`}</span>
        </div>
    </div>
</div>
</a>
