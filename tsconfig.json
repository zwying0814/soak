{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": "./",
    "strictNullChecks": true,
    "allowJs": true,
    "jsx": "preserve",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "~/*": [
        "./*"
      ]
    },
    "jsxImportSource": "solid-js"
  },
  "exclude": [
    "public",
    "dist",
    ".astro",
    "node_modules",
    "plugins"
  ],
  "plugins": [
    {
      "name": "@astrojs/ts-plugin"
    }
  ]
}