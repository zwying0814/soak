---
interface Friend {
    name: string;
    avatar: string;
    link: string;
    description: string;
}

const { friends } = Astro.props;
---
<div class="grid gap-4 lg:grid-cols-3 sm:grid-cols-2 grid-cols-1">
    {
        friends.map((friend: Friend) => {
            return (
                <a href={friend.link} target="_blank"
                   class="group col-span-1 p-4 rounded-box flex items-center transition
                    hover:bg-base-300 border border-base-content/10 sm:border-transparent">
                    <div class="size-16 overflow-hidden rounded-full shrink-0 me-2">
                        <img class="size-16" src={friend.avatar} alt={friend.name}/>
                    </div>
                    <div class="flex flex-col h-full justify-evenly">
                        <div class="text-lg font-bold font-serif duration-300 group-hover:text-blue-700 dark:group-hover:text-blue-400">
                            {friend.name}
                        </div>
                        <div class="text-xs text-base-content/50">
                            {friend.description}
                        </div>
                    </div>
                </a>
            )
        })
    }
</div>